/* ==========================================================================
   1. Design tokens
   Variables keep the visual language consistent and make theme switching simple.
   ========================================================================== */

:root {
  --ink: #10272c;
  --ink-soft: #425b60;
  --paper: #f4efe5;
  --paper-alt: #ebe4d7;
  --surface: #fffdf8;
  --surface-glass: rgba(255, 253, 248, 0.76);
  --teal: #17675f;
  --teal-dark: #0e4a45;
  --teal-soft: #dcebe6;
  --orange: #cb6a31;
  --orange-soft: #f4dfd0;
  --gold: #d8ad67;
  --line: rgba(16, 39, 44, 0.14);
  --line-strong: rgba(16, 39, 44, 0.28);
  --danger: #a43e34;
  --shadow-sm: 0 10px 30px rgba(16, 39, 44, 0.08);
  --shadow-lg: 0 26px 75px rgba(16, 39, 44, 0.14);
  --radius-sm: 14px;
  --radius-md: 22px;
  --radius-lg: 34px;
  --container: 1180px;
  --header-height: 80px;
}

html[data-theme="dark"] {
  --ink: #edf4f1;
  --ink-soft: #becdc9;
  --paper: #0e1c1e;
  --paper-alt: #142a2c;
  --surface: #172b2d;
  --surface-glass: rgba(23, 43, 45, 0.82);
  --teal: #72c2b5;
  --teal-dark: #2c8278;
  --teal-soft: #1c3b3b;
  --orange: #ef9b60;
  --orange-soft: #442f25;
  --gold: #e1bc7f;
  --line: rgba(230, 243, 239, 0.15);
  --line-strong: rgba(230, 243, 239, 0.3);
  --danger: #ff8c80;
  --shadow-sm: 0 10px 30px rgba(0, 0, 0, 0.2);
  --shadow-lg: 0 26px 75px rgba(0, 0, 0, 0.32);
}

/* ==========================================================================
   2. Base and accessibility
   ========================================================================== */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: calc(var(--header-height) + 20px);
}

body {
  margin: 0;
  min-width: 320px;
  color: var(--ink);
  background:
    radial-gradient(circle at 8% 7%, rgba(203, 106, 49, 0.17), transparent 28rem),
    radial-gradient(circle at 94% 30%, rgba(23, 103, 95, 0.13), transparent 35rem),
    linear-gradient(var(--paper), var(--paper));
  font-family: "Segoe UI", "Microsoft YaHei", "PingFang SC", Arial, sans-serif;
  line-height: 1.65;
  overflow-x: hidden;
  transition: color 220ms ease, background-color 220ms ease;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: 0.34;
  background-image:
    linear-gradient(var(--line) 1px, transparent 1px),
    linear-gradient(90deg, var(--line) 1px, transparent 1px);
  background-size: 52px 52px;
  mask-image: linear-gradient(to bottom, black 0%, transparent 75%);
}

body.nav-open {
  overflow: hidden;
}

img {
  display: block;
  max-width: 100%;
}

button,
input,
textarea {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

a {
  color: inherit;
}

p,
h1,
h2,
h3,
blockquote {
  margin-top: 0;
  overflow-wrap: anywhere;
}

:focus-visible {
  outline: 3px solid var(--orange);
  outline-offset: 4px;
}

::selection {
  color: #fff;
  background: var(--teal-dark);
}

.container {
  width: min(calc(100% - 40px), var(--container));
  margin-inline: auto;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.skip-link {
  position: fixed;
  top: 12px;
  left: 12px;
  z-index: 100;
  padding: 10px 16px;
  border-radius: 10px;
  color: #fff;
  background: var(--ink);
  transform: translateY(-160%);
  transition: transform 160ms ease;
}

.skip-link:focus {
  transform: translateY(0);
}

/* The fixed progress line gives immediate feedback without adding heavy UI. */
.scroll-progress {
  position: fixed;
  inset: 0 0 auto;
  z-index: 90;
  height: 3px;
  background: transparent;
}

.scroll-progress span {
  display: block;
  width: 0;
  height: 100%;
  background: linear-gradient(90deg, var(--teal), var(--orange));
}

/* ==========================================================================
   3. Header and navigation
   ========================================================================== */

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  min-height: var(--header-height);
  border-bottom: 1px solid var(--line);
  background: color-mix(in srgb, var(--paper) 85%, transparent);
  backdrop-filter: blur(18px);
}

.navigation {
  min-height: var(--header-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 26px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: var(--ink);
  text-decoration: none;
}

.brand-mark {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  color: var(--paper);
  background: var(--ink);
  box-shadow: 0 8px 22px rgba(16, 39, 44, 0.18);
  font-size: 0.86rem;
  font-weight: 850;
  letter-spacing: 0.08em;
}

.brand-text {
  display: grid;
  line-height: 1.1;
}

.brand-text strong {
  font-size: 0.85rem;
  letter-spacing: 0.12em;
}

.brand-text small {
  margin-top: 3px;
  color: var(--teal);
  font-size: 0.68rem;
  letter-spacing: 0.06em;
}

.nav-panel {
  display: flex;
  align-items: center;
  gap: 12px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 3px;
  margin: 0;
  padding: 5px;
  list-style: none;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--surface-glass);
}

.nav-link {
  display: block;
  padding: 8px 14px;
  border-radius: 999px;
  color: var(--ink-soft);
  text-decoration: none;
  font-size: 0.8rem;
  font-weight: 700;
  transition: color 160ms ease, background 160ms ease;
}

.nav-link:hover,
.nav-link:focus-visible,
.nav-link.active {
  color: var(--surface);
  background: var(--teal-dark);
  outline: none;
}

.theme-toggle {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 50%;
  color: var(--ink);
  background: var(--surface-glass);
  cursor: pointer;
  font-size: 1.2rem;
}

.theme-toggle:hover {
  border-color: var(--teal);
}

.nav-toggle {
  display: none;
  width: 44px;
  height: 44px;
  padding: 11px;
  border: 1px solid var(--line);
  border-radius: 12px;
  color: var(--ink);
  background: var(--surface-glass);
  cursor: pointer;
}

.nav-toggle > span:not(.sr-only) {
  display: block;
  width: 100%;
  height: 2px;
  margin-block: 4px;
  background: currentColor;
  transition: transform 180ms ease, opacity 180ms ease;
}

.nav-toggle[aria-expanded="true"] > span:nth-child(1) {
  transform: translateY(6px) rotate(45deg);
}

.nav-toggle[aria-expanded="true"] > span:nth-child(2) {
  opacity: 0;
}

.nav-toggle[aria-expanded="true"] > span:nth-child(3) {
  transform: translateY(-6px) rotate(-45deg);
}

/* ==========================================================================
   4. Hero
   ========================================================================== */

.hero {
  min-height: calc(100vh - var(--header-height));
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(330px, 0.82fr);
  align-items: center;
  gap: clamp(45px, 8vw, 110px);
  padding-block: clamp(64px, 9vw, 120px);
  overflow: clip;
}

.eyebrow,
.section-index {
  margin-bottom: 18px;
  color: var(--teal);
  font-size: 0.74rem;
  font-weight: 850;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
}

.eyebrow::before {
  content: "";
  width: 34px;
  height: 2px;
  background: var(--orange);
}

.hero h1 {
  margin: 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(4.8rem, 10.5vw, 9rem);
  font-weight: 700;
  line-height: 0.78;
  letter-spacing: -0.075em;
}

.hero h1 span {
  display: block;
}

.hero-name-accent {
  margin-left: clamp(24px, 5vw, 70px);
  color: var(--orange);
  font-style: italic;
  font-weight: 500;
}

.hero-chinese {
  margin: 20px 0 0;
  color: var(--ink-soft);
  font-size: clamp(1.2rem, 2vw, 1.6rem);
  font-weight: 700;
  letter-spacing: 0.32em;
}

.hero-statement {
  max-width: 610px;
  margin: 27px 0 0;
  color: var(--ink-soft);
  font-size: clamp(1rem, 1.65vw, 1.17rem);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 11px;
  margin-top: 30px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 21px;
  border: 1px solid transparent;
  border-radius: 999px;
  cursor: pointer;
  text-decoration: none;
  font-size: 0.85rem;
  font-weight: 800;
  transition: transform 170ms ease, background 170ms ease, border-color 170ms ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button-primary {
  color: var(--paper);
  background: var(--ink);
  box-shadow: var(--shadow-sm);
}

.button-ghost {
  color: var(--ink);
  border-color: var(--line-strong);
  background: transparent;
}

.button-ghost:hover {
  border-color: var(--teal);
  background: var(--teal-soft);
}

.hero-meta {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  margin: 44px 0 0;
  padding-top: 20px;
  border-top: 1px solid var(--line);
}

.hero-meta div {
  padding-right: 18px;
}

.hero-meta div + div {
  padding-left: 18px;
  border-left: 1px solid var(--line);
}

.hero-meta dt {
  color: var(--teal);
  font-size: 0.61rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.hero-meta dd {
  margin: 4px 0 0;
  font-size: 0.85rem;
  font-weight: 700;
}

.hero-visual {
  position: relative;
  width: min(100%, 460px);
  justify-self: end;
  isolation: isolate;
}

.portrait-card {
  position: relative;
  z-index: 2;
}

.portrait-frame {
  overflow: hidden;
  border: 10px solid var(--surface-glass);
  border-radius: 42% 42% 16% 16%;
  background: var(--paper-alt);
  box-shadow: var(--shadow-lg);
}

.portrait-frame img {
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
  object-position: center 22%;
  filter: saturate(0.93) contrast(1.03);
}

.portrait-caption {
  position: relative;
  z-index: 3;
  width: calc(100% - 34px);
  display: flex;
  justify-content: space-between;
  gap: 15px;
  margin: -35px auto 0;
  padding: 16px 18px;
  border-radius: 16px;
  color: var(--paper);
  background: var(--ink);
  box-shadow: var(--shadow-sm);
  font-size: 0.7rem;
  font-weight: 750;
  letter-spacing: 0.05em;
}

.portrait-orbit {
  position: absolute;
  border: 1px solid var(--line-strong);
  border-radius: 50%;
  pointer-events: none;
}

.orbit-one {
  width: 118%;
  height: 78%;
  top: 8%;
  left: -19%;
  transform: rotate(-10deg);
}

.orbit-two {
  width: 88%;
  height: 60%;
  right: -22%;
  bottom: 2%;
  transform: rotate(17deg);
}

.floating-word {
  position: absolute;
  z-index: 4;
  color: var(--orange);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  writing-mode: vertical-rl;
}

.word-one {
  top: 5%;
  left: -24px;
}

.word-two {
  right: -24px;
  bottom: 18%;
  color: var(--teal);
}

/* ==========================================================================
   5. Reusable section layout
   ========================================================================== */

.section {
  padding-block: clamp(82px, 11vw, 140px);
  border-top: 1px solid var(--line);
}

.section-tinted {
  background:
    linear-gradient(135deg, var(--surface-glass), transparent),
    var(--paper-alt);
}

.section-dark {
  color: var(--paper);
  background: var(--teal-dark);
}

html[data-theme="dark"] .section-dark {
  color: var(--ink);
  background: #091416;
}

.section-heading {
  margin-bottom: 42px;
}

.section-heading h2,
.interests-copy h2,
.contact-copy h2 {
  max-width: 880px;
  margin: 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2.45rem, 5.3vw, 5.4rem);
  font-weight: 500;
  line-height: 1.01;
  letter-spacing: -0.055em;
}

.section-heading h2 em,
.journey-layout h2 em {
  color: var(--orange);
  font-weight: 500;
}

.section-heading-row {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 30px;
}

/* ==========================================================================
   6. About
   ========================================================================== */

.about-layout {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 24px;
  align-items: stretch;
}

.about-story,
.values-card {
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--surface-glass);
  box-shadow: var(--shadow-sm);
}

.about-story {
  padding: clamp(28px, 4.5vw, 55px);
}

.about-story p {
  margin-bottom: 18px;
  color: var(--ink-soft);
}

.about-story .lead {
  color: var(--ink);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(1.45rem, 2.7vw, 2.2rem);
  line-height: 1.35;
}

.about-story blockquote {
  margin: 34px 0 0;
  padding: 20px 0 0 23px;
  border-top: 1px solid var(--line);
  border-left: 3px solid var(--orange);
  color: var(--ink);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(1.12rem, 2vw, 1.42rem);
  font-style: italic;
}

.values-card {
  padding: clamp(27px, 4vw, 44px);
  background: var(--ink);
  color: var(--paper);
}

.card-label {
  margin: 0 0 22px;
  color: var(--orange);
  font-size: 0.66rem;
  font-weight: 850;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.values-card ol {
  display: grid;
  gap: 26px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.values-card li {
  display: grid;
  grid-template-columns: 36px 1fr;
  gap: 13px;
}

.values-card li > span {
  color: var(--gold);
  font-family: Georgia, "Times New Roman", serif;
  font-style: italic;
}

.values-card h3 {
  margin: 0 0 5px;
  font-size: 1rem;
}

.values-card li p {
  margin: 0;
  color: rgba(244, 239, 229, 0.7);
  font-size: 0.83rem;
}

.fact-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-top: 24px;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--surface-glass);
}

.fact-strip div {
  padding: 25px;
}

.fact-strip div + div {
  border-left: 1px solid var(--line);
}

.fact-strip span {
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(1.7rem, 3vw, 2.4rem);
  font-weight: 700;
}

.fact-strip p {
  margin: 5px 0 0;
  color: var(--ink-soft);
  font-size: 0.76rem;
  font-weight: 700;
}

/* ==========================================================================
   7. Focus
   ========================================================================== */

.focus-grid {
  display: grid;
  grid-template-columns: 1.35fr 0.65fr 0.65fr;
  gap: 18px;
}

.focus-card {
  display: flex;
  min-height: 360px;
  flex-direction: column;
  padding: clamp(25px, 3.5vw, 38px);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
}

.focus-card-large {
  background:
    radial-gradient(circle at 100% 0%, var(--orange-soft), transparent 48%),
    var(--surface);
}

.focus-card-dark {
  color: var(--paper);
  background: var(--ink);
}

.focus-card h3 {
  margin: 40px 0 13px;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(1.45rem, 2.4vw, 2.25rem);
  line-height: 1.15;
}

.focus-card > p:not(.card-label) {
  margin: 0;
  color: var(--ink-soft);
  font-size: 0.93rem;
}

.focus-card-dark > p:not(.card-label) {
  color: rgba(244, 239, 229, 0.7);
}

.focus-icon {
  color: var(--teal);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 2rem;
  font-weight: 700;
}

.skill-list {
  display: grid;
  gap: 0;
  margin: auto 0 0;
  padding: 18px 0 0;
  list-style: none;
  border-top: 1px solid var(--line);
}

.skill-list li {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  padding-block: 8px;
  color: var(--ink-soft);
  font-size: 0.78rem;
}

.skill-list li span:last-child {
  color: var(--teal);
  font-weight: 800;
}

/* ==========================================================================
   8. Work, filters and project cards
   ========================================================================== */

.filters {
  display: flex;
  gap: 7px;
  padding: 5px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--surface-glass);
}

.filter {
  border: 0;
  border-radius: 999px;
  padding: 8px 16px;
  color: var(--ink-soft);
  background: transparent;
  cursor: pointer;
  font-size: 0.75rem;
  font-weight: 800;
}

.filter:hover,
.filter.active {
  color: var(--paper);
  background: var(--teal-dark);
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.project-card {
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
  transition: transform 220ms ease, box-shadow 220ms ease, opacity 180ms ease;
}

.project-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-lg);
}

.project-card.is-hidden {
  display: none;
}

.project-preview {
  position: relative;
  min-height: 250px;
  overflow: hidden;
  padding: 24px;
}

.preview-label {
  font-size: 0.65rem;
  font-weight: 850;
  letter-spacing: 0.16em;
}

.project-preview-profile {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: var(--paper);
  background:
    radial-gradient(circle at 85% 12%, rgba(216, 173, 103, 0.4), transparent 9rem),
    var(--teal-dark);
}

.project-preview-profile strong {
  align-self: center;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 5.5rem;
  letter-spacing: -0.09em;
}

.project-preview-profile span:last-child {
  font-size: 0.69rem;
  font-weight: 800;
  letter-spacing: 0.17em;
}

.project-preview-calculator {
  display: grid;
  align-content: space-between;
  gap: 22px;
  color: var(--ink);
  background: var(--orange-soft);
}

.mini-display {
  align-self: center;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 5rem;
  font-weight: 700;
  line-height: 1;
  text-align: right;
}

.mini-buttons {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
}

.mini-buttons i {
  display: grid;
  height: 42px;
  place-items: center;
  border-radius: 8px;
  color: var(--paper);
  background: var(--ink);
  font-style: normal;
}

.project-preview-systems {
  display: grid;
  align-content: center;
  color: var(--paper);
  background: var(--ink);
}

.project-preview-systems .preview-label {
  position: absolute;
  top: 25px;
  left: 25px;
}

.node {
  position: relative;
  z-index: 2;
  width: fit-content;
  padding: 9px 13px;
  border: 1px solid rgba(244, 239, 229, 0.45);
  border-radius: 9px;
  font-size: 0.72rem;
}

.node-a {
  margin-left: 8%;
}

.node-b {
  margin: 13px 0 13px 42%;
}

.node-c {
  margin-left: 67%;
}

.line {
  position: absolute;
  height: 1px;
  background: rgba(244, 239, 229, 0.45);
  transform-origin: left;
}

.line-a {
  width: 40%;
  top: 54%;
  left: 20%;
  transform: rotate(20deg);
}

.line-b {
  width: 34%;
  top: 66%;
  left: 55%;
  transform: rotate(-20deg);
}

.project-content {
  padding: 25px;
}

.project-number {
  margin: 0 0 8px;
  color: var(--teal);
  font-size: 0.64rem;
  font-weight: 850;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.project-content h3 {
  margin: 0 0 11px;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.55rem;
  line-height: 1.2;
}

.project-content > p:not(.project-number) {
  margin: 0;
  color: var(--ink-soft);
  font-size: 0.86rem;
}

.text-button {
  margin-top: 20px;
  padding: 0;
  border: 0;
  border-bottom: 1px solid var(--teal);
  color: var(--teal);
  background: transparent;
  cursor: pointer;
  font-size: 0.78rem;
  font-weight: 850;
}

.text-button:hover {
  color: var(--orange);
  border-color: var(--orange);
}

/* ==========================================================================
   9. Journey
   ========================================================================== */

.journey-layout {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: clamp(38px, 8vw, 100px);
}

.section-dark .section-index {
  color: var(--gold);
}

.section-dark .section-heading h2 em {
  color: var(--gold);
}

.timeline {
  margin: 0;
  padding: 0;
  list-style: none;
  counter-reset: journey;
}

.timeline li {
  position: relative;
  padding: 0 0 32px 47px;
  counter-increment: journey;
}

.timeline li::before {
  content: counter(journey, decimal-leading-zero);
  position: absolute;
  top: -3px;
  left: 0;
  width: 31px;
  height: 31px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(244, 239, 229, 0.34);
  border-radius: 50%;
  color: var(--gold);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 0.7rem;
}

.timeline li::after {
  content: "";
  position: absolute;
  top: 36px;
  bottom: 8px;
  left: 15px;
  width: 1px;
  background: rgba(244, 239, 229, 0.2);
}

.timeline li:last-child::after {
  display: none;
}

.timeline-year {
  color: var(--gold);
  font-size: 0.7rem;
  font-weight: 850;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.timeline h3 {
  margin: 8px 0 5px;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.45rem;
}

.timeline p {
  margin: 0;
  color: rgba(244, 239, 229, 0.66);
  font-size: 0.9rem;
}

html[data-theme="dark"] .timeline p {
  color: var(--ink-soft);
}

/* ==========================================================================
   10. Interests
   ========================================================================== */

.interests {
  display: grid;
  grid-template-columns: minmax(300px, 0.9fr) minmax(0, 1.1fr);
  align-items: center;
  gap: clamp(45px, 9vw, 110px);
}

.interests-graphic {
  position: relative;
  aspect-ratio: 1;
  display: grid;
  place-items: center;
  overflow: hidden;
  border-radius: 50%;
  color: #fff;
  background:
    radial-gradient(circle, rgba(255, 255, 255, 0.14), transparent 44%),
    var(--orange);
}

.interests-graphic span {
  position: relative;
  z-index: 2;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2.2rem, 5vw, 4.8rem);
  font-style: italic;
  font-weight: 700;
}

.motion-ring {
  position: absolute;
  border: 1px solid rgba(255, 255, 255, 0.34);
  border-radius: 50%;
}

.ring-outer {
  width: 78%;
  height: 78%;
}

.ring-inner {
  width: 48%;
  height: 48%;
}

.interests-copy h2 {
  margin-bottom: 22px;
}

.interests-copy > p:not(.section-index) {
  max-width: 640px;
  margin: 0;
  color: var(--ink-soft);
  font-size: 1.02rem;
}

/* ==========================================================================
   11. Contact
   ========================================================================== */

.contact {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: clamp(38px, 7vw, 95px);
  align-items: start;
}

.contact-copy h2 {
  max-width: 650px;
  margin-bottom: 22px;
  font-size: clamp(2.25rem, 4.5vw, 4.4rem);
}

.contact-copy > p:not(.section-index) {
  max-width: 560px;
  color: var(--ink-soft);
}

.contact-details {
  display: grid;
  gap: 18px;
  margin: 34px 0 0;
  padding-top: 22px;
  border-top: 1px solid var(--line);
}

.contact-details dt {
  color: var(--teal);
  font-size: 0.66rem;
  font-weight: 850;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.contact-details dd {
  margin: 3px 0 0;
  font-size: 0.9rem;
}

.contact-form {
  padding: clamp(25px, 4vw, 42px);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--surface);
  box-shadow: var(--shadow-lg);
}

.field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.form-field {
  margin-bottom: 18px;
}

.form-field label {
  display: block;
  margin-bottom: 7px;
  font-size: 0.71rem;
  font-weight: 850;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.form-field input,
.form-field textarea {
  width: 100%;
  padding: 13px 14px;
  border: 1px solid var(--line);
  border-radius: 12px;
  color: var(--ink);
  background: var(--paper);
  transition: border-color 150ms ease, box-shadow 150ms ease;
}

.form-field textarea {
  resize: vertical;
  min-height: 130px;
}

.form-field input:focus,
.form-field textarea:focus {
  outline: none;
  border-color: var(--teal);
  box-shadow: 0 0 0 4px color-mix(in srgb, var(--teal) 14%, transparent);
}

.form-field input[aria-invalid="true"],
.form-field textarea[aria-invalid="true"] {
  border-color: var(--danger);
  box-shadow: 0 0 0 4px color-mix(in srgb, var(--danger) 12%, transparent);
}

.field-error {
  min-height: 18px;
  margin: 5px 0 0;
  color: var(--danger);
  font-size: 0.72rem;
  font-weight: 700;
}

.field-meta {
  display: flex;
  justify-content: space-between;
  gap: 15px;
}

.field-meta > span {
  color: var(--ink-soft);
  font-size: 0.7rem;
}

.form-submit {
  min-width: 170px;
}

.form-status {
  min-height: 24px;
  margin: 15px 0 0;
  color: var(--teal);
  font-size: 0.82rem;
  font-weight: 750;
}

/* ==========================================================================
   12. Footer and project dialog
   ========================================================================== */

.site-footer {
  padding-block: 40px;
  border-top: 1px solid var(--line);
  background: color-mix(in srgb, var(--paper-alt) 60%, transparent);
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  gap: 25px;
  align-items: end;
}

.footer-inner strong {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.25rem;
}

.footer-inner p {
  margin: 3px 0 0;
  color: var(--ink-soft);
  font-size: 0.74rem;
}

.footer-inner a {
  color: var(--teal);
  font-size: 0.78rem;
  font-weight: 800;
  text-decoration: none;
}

.project-dialog {
  width: min(calc(100% - 30px), 680px);
  padding: clamp(28px, 5vw, 52px);
  border: 0;
  border-radius: 28px;
  color: var(--ink);
  background: var(--surface);
  box-shadow: var(--shadow-lg);
}

.project-dialog::backdrop {
  background: rgba(5, 18, 20, 0.72);
  backdrop-filter: blur(5px);
}

.dialog-close {
  position: absolute;
  top: 17px;
  right: 17px;
  width: 38px;
  height: 38px;
  border: 1px solid var(--line);
  border-radius: 50%;
  color: var(--ink);
  background: transparent;
  cursor: pointer;
  font-size: 1.25rem;
}

.dialog-label {
  margin-bottom: 8px;
  color: var(--teal);
  font-size: 0.65rem;
  font-weight: 850;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.project-dialog h2 {
  margin: 0 40px 15px 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(1.8rem, 4vw, 3rem);
  line-height: 1.1;
}

.dialog-summary,
.dialog-details p {
  color: var(--ink-soft);
}

.dialog-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-top: 22px;
}

.dialog-details div {
  padding: 17px;
  border-radius: 14px;
  background: var(--paper);
}

.dialog-details h3 {
  margin-bottom: 5px;
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.dialog-details p {
  margin: 0;
  font-size: 0.82rem;
}

.dialog-done {
  margin-top: 24px;
}

.noscript-message {
  margin: 0;
  padding: 16px;
  text-align: center;
  color: #fff;
  background: var(--danger);
}

/* Content remains visible by default. The class is retained for optional
   progressive enhancement without risking invisible content if observation is delayed. */
.js .reveal {
  opacity: 1;
  transform: none;
}

.js .reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ==========================================================================
   13. Responsive layout
   ========================================================================== */

@media (max-width: 980px) {
  .hero {
    grid-template-columns: 1fr;
    min-height: auto;
    padding-top: 64px;
  }

  .hero-visual {
    width: min(100%, 440px);
    justify-self: center;
    margin-top: 20px;
  }

  .about-layout,
  .journey-layout,
  .interests,
  .contact {
    grid-template-columns: 1fr;
  }

  .focus-grid {
    grid-template-columns: 1fr 1fr;
  }

  .focus-card-large {
    grid-column: 1 / -1;
    min-height: 300px;
  }

  .project-grid {
    grid-template-columns: 1fr 1fr;
  }

  .project-card:last-child {
    grid-column: 1 / -1;
  }

  .interests-graphic {
    width: min(100%, 480px);
    justify-self: center;
  }
}

@media (max-width: 780px) {
  .nav-toggle {
    display: block;
  }

  .nav-panel {
    position: fixed;
    inset: var(--header-height) 0 auto;
    display: grid;
    gap: 17px;
    padding: 24px 20px 28px;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    box-shadow: var(--shadow-lg);
    transform: translateY(-120%);
    visibility: hidden;
    transition: transform 220ms ease, visibility 220ms ease;
  }

  .nav-panel.open {
    transform: translateY(0);
    visibility: visible;
  }

  .nav-links {
    display: grid;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .nav-link {
    padding: 11px 12px;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
  }

  .theme-toggle {
    justify-self: start;
  }

  .section-heading-row {
    align-items: flex-start;
    flex-direction: column;
  }

  .fact-strip {
    grid-template-columns: 1fr 1fr;
  }

  .fact-strip div:nth-child(3) {
    border-left: 0;
    border-top: 1px solid var(--line);
  }

  .fact-strip div:nth-child(4) {
    border-top: 1px solid var(--line);
  }

  .dialog-details {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .container {
    width: min(calc(100% - 24px), var(--container));
  }

  .brand-text small {
    display: none;
  }

  .hero h1 {
    font-size: clamp(4rem, 22vw, 6.2rem);
  }

  .hero-name-accent {
    margin-left: 15px;
  }

  .hero-meta {
    grid-template-columns: 1fr;
    gap: 13px;
  }

  .hero-meta div,
  .hero-meta div + div {
    padding: 0;
    border: 0;
  }

  .hero-meta div {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }

  .hero-meta dd {
    margin: 0;
    text-align: right;
  }

  .focus-grid,
  .project-grid,
  .fact-strip,
  .field-row {
    grid-template-columns: 1fr;
  }

  .project-card:last-child {
    grid-column: auto;
  }

  .fact-strip div + div,
  .fact-strip div:nth-child(3),
  .fact-strip div:nth-child(4) {
    border-top: 1px solid var(--line);
    border-left: 0;
  }

  .filters {
    align-self: stretch;
    justify-content: space-between;
  }

  .filter {
    flex: 1;
  }

  .footer-inner {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }

  .js .reveal {
    opacity: 1;
    transform: none;
  }
}
